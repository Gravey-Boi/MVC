@{
}

@model List<ProfileSelectItem>

<style>
    .profilesText {
        align-self : center;
    }

    .profileButtonsContainer {
        display : flex;
        flex-direction : row;
        gap : 20px;
    }

    .profileSelectButton {
        width : 128px;
        height : 96px;
        color : white;
        background-color : #363B40;
        border-radius : 8px;
        border : 0px;
        text-align : center;
        align-content : center;
        line-height : 0px;
        text-decoration : none;
        font-size : 20px;
    }

    .profileSelectButton:hover {
        background-color: #2C3036;
    }

    .profileSelectButton:active {
        background-color: #25292E;
    }
</style>

<div>
    <h4 class="profilesText">Profiles</h4>
    <div class="profileButtonsContainer">
        @foreach(ProfileSelectItem profile in Model)
        {
            <a class="profileSelectButton" asp-area="" asp-controller="Home" asp-action="Index" asp-route-id="">@profile.profileName</a>
        }
    </div>
</div>